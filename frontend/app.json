{
  "expo": {
    "name": "Tempus",
    "slug": "Tempus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/TempusIcon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Tempus",
      "icon": "./assets/images/TempusIcon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.Tempus"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/TempusIcon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "Tempus uses HealthKit to read your health data including heart rate, step count, and sleep patterns to optimize task scheduling based on your energy levels and activity patterns.",
          "healthUpdatePermission": "Tempus uses HealthKit to write workout and activity data when you complete fitness-related tasks to help track your progress.",
          "isClinicalDataEnabled": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5132446c-7775-4557-89b7-383b9eb91f8e"
      }
    },
    "owner": "rom7699"
  }
}
